# Client
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Optional. Defaults to the page origin, so leave it unset on Cloudflare Pages Preview deployments.
VITE_AUTH0_REDIRECT_URI=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5174
VITE_KOFI_URL=

# Server
PORT=5174
DATABASE_URL=file:./dev.db
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=
ALLOWED_ORIGIN=http://localhost:3000
ASSETS_DIR=../assets

# Image storage. "local" keeps files under server/storage (development only; Render's disk is
# ephemeral). "r2" uses Cloudflare R2. Setup and migration steps: server/STORAGE.md
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Cloudflare R2 (required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Signs /api/images/:id/content URLs. Any long random string, e.g. `openssl rand -hex 32`.
URL_SIGNING_SECRET=
# How long image URLs handed to the browser stay valid, in seconds.
IMAGE_URL_TTL_SECONDS=900

# Cloudflare Pages only (set in the Pages dashboard, not in a .env file)
# API_ORIGIN=https://<render-service>.onrender.com   # where /api/* is proxied; Production and Preview
# ALLOW_API_OVERRIDE=true                            # Preview only; enables /api/__preview?origin=... pinning
