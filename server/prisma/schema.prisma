generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model users {
  id            Int      @id @default(autoincrement())
  auth_provider String
  auth_sub      String   @unique
  email         String?  @unique
  name          String?
  avatar_url    String?
  // Free-form JSON blob of per-user UI preferences (explorer view mode, previews, ...).
  preferences   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  cards         cards[]
  themes        user_themes[]
  folders       folders[]
}

model cards {
  id             Int          @id @default(autoincrement())
  user_id        Int
  folder_id      Int?
  title          String
  general        String
  card_name      String? 
  tribe_name     String?
  species        String?
  uniqueness     String?
  class          String?
  personality    String?
  size           String?
  life           String?
  move           String?
  range          String?
  attack         String?
  defense        String?
  points         String?
  theme_primary_hex   String?
  theme_secondary_hex String?
  theme_background_hex String?
  hitbox_json          String?
  schema_version Int          @default(1)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  user    users       @relation(fields: [user_id], references: [id])
  folder  folders?    @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  powers  card_powers[]
  images  card_images[]
  thumbnail card_thumbnails?

  @@index([user_id, folder_id])
}

// Small rendered preview of a card, uploaded by the editor after autosave. Kept in its own table
// so listing cards never drags the image bytes along.
model card_thumbnails {
  card_id    Int      @id
  mime       String
  blob       Bytes
  updated_at DateTime @updatedAt

  card cards @relation(fields: [card_id], references: [id], onDelete: Cascade)
}

// Recursive folder tree for organizing cards. parent_id = null means the folder lives at the root.
// Deleting a folder cascades to its subfolders and the cards inside them.
model folders {
  id         Int      @id @default(autoincrement())
  user_id    Int
  parent_id  Int?
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent   folders?  @relation("folder_tree", fields: [parent_id], references: [id], onDelete: Cascade)
  children folders[] @relation("folder_tree")
  cards    cards[]

  @@index([user_id, parent_id])
}

model card_powers {
  id       Int    @id @default(autoincrement())
  card_id  Int
  order    Int
  heading  String
  body     String

  card cards @relation(fields: [card_id], references: [id], onDelete: Cascade)
}

// Image layers on a card. The bytes live in object storage (see src/storage.js) under `object_key`,
// which is content-addressed as u/<user_id>/<sha256> so a user re-uploading the same picture stores it
// once. `blob` only holds bytes for rows created before object storage existed; the backfill script
// (scripts/backfill-images.js) uploads them and clears the column.
model card_images {
  id        Int      @id @default(autoincrement())
  card_id   Int
  order     Int
  x         Float
  y         Float
  scale     Float
  rotation  Float?
  name      String?
  blob      Bytes?
  object_key String?
  mime       String?
  size_bytes Int?
  sha256     String?
  created_at DateTime @default(now())

  card cards @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([object_key])
}

model user_themes {
  id              Int      @id @default(autoincrement())
  user_id         Int
  name            String
  primary_hex     String
  secondary_hex   String
  background_hex  String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name])
}
